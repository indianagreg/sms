<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.greg.sms-followup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/greg/sms/scripts/run_daily.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/greg/sms</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/greg/Library/Logs/sms-followup.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/greg/Library/Logs/sms-followup.err.log</string>
</dict>
</plist>
