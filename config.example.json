{
  "lookback_hours": 72,
  "minimum_age_hours": 4,
  "max_threads": 30,
  "ignore_contacts": [],
  "ignore_group_chats": false,
  "resolve_contacts": true,
  "state_path": "~/.sms-followup/state.sqlite",
  "use_ai": false,
  "openrouter_model": "openai/gpt-4.1-mini",
  "openrouter_api_key_env": "OPENROUTER_API_KEY",
  "email": {
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 465,
    "smtp_use_ssl": true,
    "smtp_username": "you@example.com",
    "smtp_password_env": "SMS_FOLLOWUP_SMTP_PASSWORD",
    "from_address": "you@example.com",
    "to_address": "you@example.com",
    "subject_prefix": "SMS follow-up"
  }
}
